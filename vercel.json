{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix shop ci",
  "buildCommand": "npm --prefix shop run build",
  "outputDirectory": "shop/dist",
  "rewrites": [
    {
      "source": "/api/refresh",
      "destination": "/api/refresh.html"
    },
    {
      "source": "/customize",
      "destination": "/index.html"
    },
    {
      "source": "/trending",
      "destination": "/index.html"
    },
    {
      "source": "/menu/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
